// C:\DataFlex Projects\FutbolWebApp\AppSrc\JugadorLista.wo
// jugadorLista
//

Use cWebModalDialog.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebPromptList.pkg
Use cWebColumn.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cjugadorDataDictionary.dd

Object oJugadorLista is a cWebModalDialog
    Set piColumnCount to 12
    Set psCaption to "jugadorLista"
    Set piWidth to 700
    Set piHeight to 400

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object ojugador_DD is a cjugadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To ojugador_DD
    Set Server  To ojugador_DD


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oPromptList is a cWebPromptList
            Set pbFillHeight to True
            Set piColumnSpan to 12

            Object ojugadorID is a cWebColumn
                Entry_Item jugador.ID
                Set psCaption to "ID"
                Set piWidth to 124
            End_Object 

            Object ojugadorNombre is a cWebColumn
                Entry_Item jugador.Nombre
                Set psCaption to "Nombre"
                Set piWidth to 745
            End_Object 

            Object ojugadorApellido is a cWebColumn
                Entry_Item jugador.Apellido
                Set psCaption to "Apellido"
                Set piWidth to 745
            End_Object 

            Object ojugadorNacionalidad is a cWebColumn
                Entry_Item jugador.Nacionalidad
                Set psCaption to "Nacionalidad"
                Set piWidth to 621
            End_Object 

            Object oequipoID is a cWebColumn
                Entry_Item equipo.ID
                Set psCaption to "EquipoID"
                Set piWidth to 124
            End_Object 
        End_Object 

        Object oOkButton is a cWebButton
            Set psCaption to "OK"
            Set piColumnSpan to 2
            Set piColumnIndex to 6

            Procedure OnClick
                Send Ok of oPromptList
            End_Procedure

        End_Object 

        Object oCancelButton is a cWebButton
            Set psCaption to "Cancel"
            Set piColumnSpan to 2
            Set piColumnIndex to 8
            Procedure OnClick
                Send Cancel of oPromptList
            End_Procedure

        End_Object 

        Object oSearchButton is a cWebButton
            Set psCaption to "Search..."
            Set piColumnSpan to 2
            Set piColumnIndex to 10

            Procedure OnClick
                Send Search of oPromptList
            End_Procedure

        End_Object 
    End_Object 

    Procedure Popup Handle hoReturnObject
        Forward Send Popup hoReturnObject
        
        Send InitializePromptList of oPromptList
    End_Procedure 

    Set pbServerOnSubmit to True
    Procedure OnSubmit 
        Send Ok of oPromptList
    End_Procedure 

End_Object 
